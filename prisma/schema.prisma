generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum LicenseType {
  DAILY
  WEEKLY
  MONTHLY
  LIFETIME
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  REVOKED
  SUSPENDED
}

enum PaymentMethod {
  CRYPTO_BTC
  CRYPTO_ETH
  CRYPTO_USDT
  CRYPTO_LTC
  PAYPAL
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String?  @unique
  image        String?
  role         Role     @default(USER)
  passwordHash String?
  referralCode String   @unique
  referredById String?
  banned       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  licenses License[]
  payments Payment[]

  referredBy User?  @relation("Referrals", fields: [referredById], references: [id])
  referrals  User[] @relation("Referrals")
}

model License {
  id            String        @id @default(cuid())
  key           String        @unique @default(cuid())
  type          LicenseType
  status        LicenseStatus @default(ACTIVE)
  hwid          String?
  hwidResetAt   DateTime?
  sessionToken  String?
  lastHeartbeat DateTime?
  userId        String?
  expiresAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user     User?     @relation(fields: [userId], references: [id])
  payments Payment[]

  @@index([userId])
  @@index([key])
  @@index([status])
  @@index([sessionToken])
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  REJECTED
}

model Payment {
  id          String        @id @default(cuid())
  userId      String
  plan        LicenseType
  amount      Float
  currency    String        @default("EUR")
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  discountPct Int           @default(0)
  txRef       String?
  licenseId   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  license License? @relation(fields: [licenseId], references: [id])

  @@index([userId])
  @@index([status])
}

model Post {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  excerpt    String?
  content    String
  published  Boolean  @default(false)
  categoryId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id])

  @@index([slug])
  @@index([published])
}

model Category {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  posts Post[]
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Download {
  id        String   @id @default(cuid())
  version   String
  fileName  String
  fileUrl   String
  checksum  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}
